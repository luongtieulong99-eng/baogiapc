                        <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Chọn dòng xe VinFast</label>
                        <select id="chonXe" onchange="changeCar()" class="w-full border border-slate-300 rounded-lg p-2 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none font-bold text-slate-800 text-xs shadow-sm cursor-pointer">
                            <option value="custom" data-price="0">-- Chọn dòng xe --</option>
                            <option value="VF2" data-price="188000000">VF 2</option>
                            <option value="VF3_ECO" data-price="285000000" selected>VF 3 ECO</option>
                            <option value="VF3_PLUS" data-price="296000000">VF 3 PLUS</option>
                            <option value="VF5" data-price="496000000">VF 5</option>
                            <option value="MinioGreen" data-price="188000000">Minio Green</option>
                            <option value="HerioGreen" data-price="450000000">Herio Green</option>
