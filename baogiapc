                            </div>

                            <div class="bg-blue-50/60 p-2 rounded-lg border border-blue-200/80 space-y-0.5 flex flex-col justify-center text-[11px]">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-700 font-medium">Tổng chi phí lăn bánh:</span>
                                    <span id="outTongLanBanh" class="font-bold text-slate-900">0 đ</span>
                                </div>
                                <hr class="border-blue-200/60 my-0.5">
                                <div class="flex justify-between items-center text-blue-900">
                                    <span class="font-bold text-xs">CẦN TRẢ TRƯỚC:</span>
                                    <span id="outCanTraTruoc" class="font-black text-blue-600 text-sm">0 đ</span>
                                </div>
                                <div class="flex justify-between items-center text-[10px]">
                                    <span class="text-slate-600">Vay ngân hàng:</span>
                                    <span id="outSoTienVay" class="font-bold text-slate-800">0 đ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 36-Month Schedule Table Area -->
                    <div class="flex-1 flex flex-col min-h-0 pt-0.5">
                        <div class="flex justify-between items-center mb-1">
                            <p class="text-xs font-black text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                                <span>📅 LỊCH TRẢ NỢ (36 THÁNG ĐẦU)</span>
                            </p>
                            <span id="outScheduleNote" class="text-[9px] bg-slate-100 text-slate-700 font-bold px-2 py-0.5 rounded border border-slate-200">
                                36 kỳ hiển thị / Tổng <span id="outTotalKỳText">84</span> kỳ
                            </span>
                        </div>
                        
                        <!-- Scrollable Table Body Container -->
                        <div id="tableScrollContainer" class="flex-1 overflow-y-auto border border-slate-200 rounded-lg shadow-inner bg-white">
                            <table class="w-full text-left text-[11px] border-collapse">
                                <thead class="sticky top-0 bg-slate-100 text-slate-700 font-bold border-b border-slate-200 shadow-sm z-10">
                                    <tr>
                                        <th class="p-1.5 text-center w-10">Kỳ</th>
                                        <th class="p-1.5 text-right">Gốc trả</th>
                                        <th class="p-1.5 text-right">Lãi trả</th>
                                        <th class="p-1.5 text-right font-black text-blue-700">Tổng trả/tháng</th>
                                        <th class="p-1.5 text-right">Dư nợ còn</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBodySchedule" class="divide-y divide-slate-100 bg-white">
                                    <!-- Dynamic rows generated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Footer Info TVBH -->
                    <div class="pt-1.5 border-t flex justify-between items-center text-[11px] text-slate-500">
                        <div class="flex items-center space-x-1.5">
                            <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                            <span class="font-bold text-slate-700 uppercase">TƯ VẤN BÁN HÀNG VINFAST: LONG</span>
                        </div>
                        <div>
                            <span class="text-slate-500">Hotline / Zalo:</span>
                            <span class="font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">0913.826.699</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
