            <!-- RIGHT COLUMN: CAPTURE DISPLAY AREA & 36 MONTH TABLE (7/12 WIDTH) -->
            <div id="captureArea" class="col-span-7 bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col justify-between overflow-hidden">
                
