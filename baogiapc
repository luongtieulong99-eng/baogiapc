                <div class="bg-white/10 p-2 rounded-xl backdrop-blur-md border border-white/20">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path></svg>
                </div>
                <div>
                    <h1 class="text-base font-black tracking-wide uppercase">BẢNG DỰ TOÁN BÁO GIÁ CẤP TỐC VINFAST</h1>
                    <p class="text-[11px] text-blue-100 opacity-90">Tự động tính toán chi phí lăn bánh & Lịch trả góp 36 kỳ (Chuẩn PC 4:3)</p>
                </div>
            </div>
            
            <!-- Header Actions -->
            <div class="flex items-center gap-2.5">
                <button id="btnDownload" onclick="downloadImage()" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold px-3.5 py-2 rounded-lg shadow-sm transition flex items-center gap-1.5 active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    <span>Tải Ảnh 4:3</span>
                </button>
                <button onclick="shareZalo()" class="bg-white hover:bg-slate-100 text-blue-700 text-xs font-bold px-3.5 py-2 rounded-lg shadow-sm transition flex items-center gap-1.5 active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.912 1.455 5.518 3.734 7.218-.163.955-.672 2.223-1.666 3.102 0 0 2.302.164 4.195-1.127.876.242 1.802.373 2.737.373 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2z"/></svg>
                    <span>Gửi Zalo</span>
                </button>
            </div>
        </header>

        <div class="grid grid-cols-12 gap-4 p-4 flex-1 min-h-0">
            
            <!-- LEFT COLUMN: INPUT CONTROLS (5/12 WIDTH) -->
            <div class="col-span-5 bg-white p-3.5 rounded-xl shadow-sm border border-slate-200/90 flex flex-col justify-between overflow-y-auto space-y-2.5">
                
                <div class="space-y-2.5">
                    <div class="border-b border-slate-100 pb-1.5">
                        <h2 class="text-[11px] font-bold text-blue-800 uppercase tracking-wider flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                            1. Dòng xe & Chi phí ban đầu
                        </h2>
                    </div>

                    <!-- Select Car Model (Names without colors) -->
