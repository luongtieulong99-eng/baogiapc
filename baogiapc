                            <option value="ECVAN_TC" data-price="268000000">EC Van TC</option>
                            <option value="ECVAN_NC" data-price="286000000">EC Van NC</option>
                            <option value="ECVAN_NC_CT" data-price="306000000">EC Van NC CT</option>
                            <option value="MPV7" data-price="750000000">MPV 7 chỗ</option>
                            <option value="VF6_Eco" data-price="650000000">VF 6 Eco</option>
                            <option value="VF6_Plus" data-price="710000000">VF 6 Plus</option>
                            <option value="VF7_Eco" data-price="740000000">VinFast VF 7 Eco</option>
                            <option value="VF7_Plus" data-price="889000000">VinFast VF 7 Plus</option>
                            <option value="VF8_Eco" data-price="910000000">VinFast VF 8 Eco</option>
                            <option value="VF8_Plus" data-price="1079000000">VinFast VF 8 Plus</option>
                            <option value="VF9_Eco" data-price="1348000000">VinFast VF 9 Eco</option>
                            <option value="VF9_Plus" data-price="1529000000">VinFast VF 9 Plus</option>
                        </select>
                    </div>

                    <!-- Price Inputs Grid -->
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[10px] font-semibold text-slate-600 mb-0.5">Giá xe niêm yết (VNĐ)</label>
                            <input type="number" id="giaXe" value="285000000" step="1000000" oninput="calculate()" class="w-full border border-slate-300 rounded-lg p-1.5 focus:ring-2 focus:ring-blue-500 focus:outline-none font-bold text-blue-600 text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-slate-600 mb-0.5">Khuyến mãi / Giảm giá</label>
                            <input type="number" id="khuyenMai" value="0" step="1000000" oninput="calculate()" class="w-full border border-slate-300 rounded-lg p-1.5 focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs">
                        </div>
                    </div>

                    <!-- Registration Expense -->
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-600 mb-0.5">Chi phí đăng ký / Lăn bánh (VNĐ)</label>
                        <input type="number" id="phiDangKy" value="12000000" step="500000" oninput="calculate()" class="w-full border border-slate-300 rounded-lg p-1.5 focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs">
                    </div>

                    <!-- Physical Hull Insurance (BHTV) -->
                    <div class="bg-amber-50/80 p-2 rounded-lg border border-amber-200/80 space-y-1">
                        <div class="flex items-center justify-between">
                            <label class="flex items-center gap-1.5 cursor-pointer">
                                <input type="checkbox" id="checkBHTV" checked onchange="calculate()" class="w-3.5 h-3.5 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer">
                                <span class="text-[10px] font-bold text-amber-900 uppercase">Bảo hiểm thân vỏ</span>
                            </label>
                            <span id="outBHTVValue" class="text-xs font-bold text-amber-800">0 đ</span>
                        </div>
                        
                        <div id="boxBHTVConfig" class="grid grid-cols-2 gap-2 text-xs pt-1 border-t border-amber-200/50">
                            <div>
                                <label class="block text-[9px] text-slate-600">Phí BHTV (%/năm)</label>
                                <input type="number" id="tyLeBHTV" value="1.3" step="0.1" oninput="calculate()" class="w-full border border-slate-300 rounded p-1 text-xs focus:ring-1 focus:ring-blue-500 bg-white font-medium">
                            </div>
                            <div>
                                <label class="block text-[9px] text-slate-600">Thanh toán BHTV</label>
                                <select id="cachTraBHTV" onchange="calculate()" class="w-full border border-slate-300 rounded p-1 text-xs focus:ring-1 focus:ring-blue-500 bg-white cursor-pointer font-medium">
                                    <option value="cash">Tiền mặt (Lăn bánh)</option>
                                    <option value="loan">Gộp vào khoản vay</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="border-b border-slate-100 pt-1 pb-1">
                        <h2 class="text-[11px] font-bold text-blue-800 uppercase tracking-wider flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                            2. Tùy chọn vay ngân hàng
                        </h2>
                    </div>

                    <!-- Down Payment Slider -->
                    <div>
                        <div class="flex justify-between items-center mb-0.5">
                            <label class="text-[10px] font-semibold text-slate-600 uppercase">Tỷ lệ trả trước</label>
                            <span id="labelTyLe" class="text-xs font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded">20%</span>
                        </div>
                        <input type="range" id="tyLeTraTruoc" min="0" max="90" step="5" value="20" oninput="calculate()" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600">
                    </div>

                    <!-- Year Selection (3 - 8 Years) -->
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-600 uppercase mb-1">Thời hạn vay (Năm)</label>
                        <div class="grid grid-cols-6 gap-1" id="groupYearBtns">
                            <button type="button" onclick="selectYear(3)" id="btnY3" class="btn-year py-1 text-[10px] font-bold rounded-md border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">3 năm</button>
                            <button type="button" onclick="selectYear(4)" id="btnY4" class="btn-year py-1 text-[10px] font-bold rounded-md border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">4 năm</button>
                            <button type="button" onclick="selectYear(5)" id="btnY5" class="btn-year py-1 text-[10px] font-bold rounded-md border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">5 năm</button>
                            <button type="button" onclick="selectYear(6)" id="btnY6" class="btn-year py-1 text-[10px] font-bold rounded-md border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">6 năm</button>
                            <button type="button" onclick="selectYear(7)" id="btnY7" class="btn-year py-1 text-[10px] font-bold rounded-md border border-blue-600 bg-blue-600 text-white transition">7 năm</button>
                            <button type="button" onclick="selectYear(8)" id="btnY8" class="btn-year py-1 text-[10px] font-bold rounded-md border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition">8 năm</button>
                        </div>
                    </div>

                    <!-- Repayment Strategy Method -->
                    <div>
                        <label class="block text-[10px] font-semibold text-slate-600 uppercase mb-1">Phương thức trả gốc</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" onclick="selectMethod('nien_kim')" id="btnNienKim" class="btn-method py-1 px-2 text-[10px] font-bold rounded-md border border-slate-300 bg-white text-slate-700 transition">Niên kim cố định</button>
                            <button type="button" onclick="selectMethod('giam_dan')" id="btnGiamDan" class="btn-method py-1 px-2 text-[10px] font-bold rounded-md border border-blue-600 bg-blue-600 text-white transition">Dư nợ giảm dần</button>
                        </div>
                    </div>

                    <!-- Interest Rates Configuration -->
                    <div class="space-y-1.5 bg-slate-50 p-2 rounded-lg border border-slate-200">
                        <div class="grid grid-cols-3 gap-1.5 items-center">
                            <div>
                                <label class="block text-[9px] font-bold text-slate-600">Gói ưu đãi</label>
                                <select id="goiUuDai" onchange="calculate()" class="w-full border border-slate-300 rounded p-1 bg-white text-[10px] font-medium cursor-pointer">
                                    <option value="12">Cố định 1 năm</option>
                                    <option value="24">Cố định 2 năm</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[9px] font-bold text-slate-600">Lãi ưu đãi (%/năm)</label>
                                <input type="number" id="laiUuDai" value="7.5" step="0.1" oninput="calculate()" class="w-full border border-slate-300 rounded p-1 text-xs bg-white font-semibold">
                            </div>
                            <div>
                                <label id="labelLaiThaNoi" class="block text-[9px] font-bold text-slate-600">Lãi thả nổi (%/năm)</label>
                                <input type="number" id="laiThaNoi" value="10.5" step="0.1" oninput="calculate()" class="w-full border border-slate-300 rounded p-1 text-xs bg-white font-semibold">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-1.5 text-[9px] text-slate-400 text-center border-t border-slate-100">
                    * Bảng dự toán mang tính chất tham khảo chi phí thực tế.
